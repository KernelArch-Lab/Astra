# ============================================================================
# Astra Runtime .gitignore
# ============================================================================

# Build directories
build/
build_*/
out/
cmake-build-*/

# Compiled objects
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.lib

# Executables
*.exe
*.out
astra_runtime
astractl

# Precompiled headers
*.gch
*.pch

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
*.cmake
!cmake/**/*.cmake
!CMakeLists.txt
# Hand-written Makefiles under formal/ drive verification tools
# (CBMC etc.) and are NOT CMake-generated. Keep them tracked.
# Same for papers/ — paper-build Makefiles are tracked.
!formal/**/Makefile
!papers/**/Makefile

# IDE and editor files
# .vscode/ is normally gitignored, BUT we ship .vscode/launch.json and
# .vscode/tasks.json (the walkthrough + ctest debugger configs) — those
# are tracked explicitly below. Any other .vscode/* files stay ignored.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
.project
.cproject
.settings/
*.code-workspace
.cache/

# Sanitizer outputs
*.asan
*.msan
*.tsan
*.ubsan
sanitizer_*.log

# Fuzzing corpus and crashes
tests/**/fuzz/corpus/
tests/**/fuzz/crashes/
tests/**/fuzz/artifacts/

# Coverage
*.gcda
*.gcno
*.gcov
coverage/
lcov.info

# Profiling
*.prof
*.perf
perf.data
perf.data.old
flamegraph*.svg

# Core dumps
# core
core.*
vgcore.*

# Dependency tracking
.deps/
.dirstamp

# Third party build artifacts
third_party/**/build/
third_party/**/install/

# AI pipeline
ai_pipeline/**/*.onnx
ai_pipeline/**/*.pt
ai_pipeline/datasets/*.csv
ai_pipeline/datasets/*.bin
__pycache__/
*.pyc

# Documentation build output
docs/_build/
docs/html/
docs/latex/

# OS files
.DS_Store
Thumbs.db

# Temporary
*.tmp
*.bak
*.log

# CTest scratch output at repo root (created by ctest runs)
Testing/

# Linux-container validation build dirs
build-linux/
build-linux-rel/

# Paper 1 — generated artefacts (regenerate via run_paper1_sweep.sh + build.sh)
artefact/
papers/paper1/main.pdf
papers/paper1/main.log
papers/paper1/main.blg
papers/paper1/*.aux
papers/paper1/*.bbl
papers/paper1/*.out
papers/paper1/figures/*.pdf
papers/paper1/figures/*.STUB
papers/paper1/figures/*.aux
papers/paper1/figures/*.log
papers/paper1/submission/anonymous.tar.gz
papers/paper1/submission/_stage/

# Claude Code local state
.claude/

# Paper-1 one-command pipeline (compile-astra.sh paper1)
build-paper1/
third_party/aeron/

# Personal documents — offer letters for named individuals. Never track these.
Offer Letter/
